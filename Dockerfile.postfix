# Force rebuild to apply milter socket changes
FROM mwader/postfix-relay:latest

# Script para esperar a las llaves de Rails y configurar OpenDKIM
RUN echo '#!/bin/bash\n\
  echo "Iniciando sincronización DKIM..."\n\
  MAX_RETRIES=15\n\
  RETRY_COUNT=0\n\
  while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do\n\
  echo "--- DEBUG: Estado de /etc/opendkim (Intento $RETRY_COUNT/$MAX_RETRIES) ---"\n\
  ls -lR /etc/opendkim || echo "/etc/opendkim no disponible"\n\
  \n\
  if [ -f "/etc/opendkim/opendkim.conf" ] && [ -d "/etc/opendkim/keys" ] && [ -n "$(ls -A /etc/opendkim/keys 2>/dev/null)" ]; then\n\
  echo "Estructura de DKIM detectada."\n\
  break\n\
  fi\n\
  echo "Esperando configuraciones... reintentando en 4s"\n\
  sleep 4\n\
  RETRY_COUNT=$((RETRY_COUNT+1))\n\
  done\n\
  \n\
  echo "Ajustando permisos y arrancando procesos..."\n\
  mkdir -p /run/opendkim\n\
  chown -R root:root /etc/opendkim\n\
  chmod -R 0755 /etc/opendkim\n\
  \n\
  # Propiedad para OpenDKIM si el usuario existe\n\
  if id "opendkim" >/dev/null 2>&1; then\n\
  chown -R opendkim:opendkim /etc/opendkim/keys 2>/dev/null || true\n\
  chown opendkim:opendkim /run/opendkim\n\
  fi\n\
  \n\
  pkill -9 opendkim || true\n\
  rm -f /run/opendkim/opendkim.pid\n\
  \n\
  if [ -f "/etc/opendkim/opendkim.conf" ]; then\n\
  echo "Lanzando OpenDKIM..."\n\
  /usr/sbin/opendkim -x /etc/opendkim/opendkim.conf -P /run/opendkim/opendkim.pid\n\
  else\n\
  echo "ADVERTENCIA: No se encontró opendkim.conf, OpenDKIM no se iniciará."\n\
  fi\n\
  \n\
  echo "Proceso de inicio DKIM finalizado. Continuando con Postfix..."\n\
  ' > /usr/local/bin/init-dkim.sh && chmod +x /usr/local/bin/init-dkim.sh

# Inyectar nuestro script en el arranque del contenedor antes de Postfix
RUN sed -i '/^service postfix start/i /usr/local/bin/init-dkim.sh \\\n' /root/run
