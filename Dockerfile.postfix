FROM mwader/postfix-relay:latest

# Script para esperar a las llaves de Rails y configurar OpenDKIM
RUN echo '#!/bin/bash\n\
echo "Esperando a que Rails exporte las llaves DKIM..."\n\
until [ -f "/etc/opendkim/keys/truek.xyz/enki.private" ]; do
  sleep 2
done
echo "Llaves detectadas. Ajustando permisos..."
mkdir -p /var/spool/postfix/opendkim
chown opendkim:opendkim /var/spool/postfix/opendkim
chmod 0750 /var/spool/postfix/opendkim
# Add postfix user to opendkim group so it can read the socket
adduser postfix opendkim

chown -R opendkim:opendkim /etc/opendkim
chmod -R 0750 /etc/opendkim
find /etc/opendkim/keys -name "*.private" -type f -exec chmod 600 {} \;

echo "Arrancando OpenDKIM con configuracion forzada..."
# Matamos cualquier proceso previo y lanzamos el nuestro con relaxed/simple
pkill -9 opendkim
/usr/sbin/opendkim -u opendkim -x /etc/opendkim/opendkim.conf -P /run/opendkim/opendkim.pid

' > /usr/local/bin/init-dkim.sh && chmod +x /usr/local/bin/init-dkim.sh

# Inyectar nuestro script en el arranque del contenedor
RUN sed -i '/^Starting OpenDKIM/i /usr/local/bin/init-dkim.sh &' /root/run
