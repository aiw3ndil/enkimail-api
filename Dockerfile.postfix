FROM mwader/postfix-relay:latest

# Copy and set up the aggressive entrypoint
COPY entrypoint-postfix.sh /usr/local/bin/entrypoint-postfix.sh
RUN chmod +x /usr/local/bin/entrypoint-postfix.sh

# Entrypoint will handle the aggressive patching and permission fixes
ENTRYPOINT ["/usr/local/bin/entrypoint-postfix.sh"]
CMD ["/root/run"]
